<!-- CS2Broadcast - by 1MP4C7 | ImpactGuard Systems -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CS2Broadcast</RootNamespace>
    <AssemblyName>CS2Broadcast</AssemblyName>
    <Authors>1MP4C7</Authors>
    <Company>ImpactGuard Systems</Company>
    <Product>CS2Broadcast</Product>
    <Description>Real-time WebSocket and HTTP REST bridge exposing CS2 server events.</Description>
    <Copyright>Copyright © ImpactGuard Systems</Copyright>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.367">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
